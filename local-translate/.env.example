# NLLB-200 Translation Service Configuration

# Device: cuda (GPU) or cpu
# Default: cuda if available, else cpu
TRANSLATE_DEVICE=cuda

# Model selection (uncomment to use a different model)
# TRANSLATE_MODEL=facebook/nllb-200-distilled-600M     # Default, ~2.4GB, fast
# TRANSLATE_MODEL=facebook/nllb-200-1.3B               # Larger, ~5GB, better quality
# TRANSLATE_MODEL=facebook/nllb-200-3.3B               # Largest, ~13GB, best quality

# Cache size for translated segments
# TRANSLATE_CACHE_SIZE=1000
