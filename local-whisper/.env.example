# Whisper Model Configuration
# Optimized for RTX 4070 laptop GPU
# Model size: tiny/base/small/medium/large-v1/large-v2/large-v3
WHISPER_MODEL=large-v3

# Model variant: base or finetuned
# base     = Use standard faster-whisper model (WHISPER_MODEL above)
# finetuned = Use your fine-tuned model from HuggingFace (WHISPER_FINETUNED_REPO below)
WHISPER_VARIANT=base

# Fine-tuned model HuggingFace repo ID (used when WHISPER_VARIANT=finetuned)
# Example: your-username/whisper-large-v3-tunisian-finetuned
# The model must be in CTranslate2 format for faster-whisper compatibility.
# If your model is in standard HF Transformers format, convert it first:
#   ct2-faster-whisper-convert --model your-username/model-name --output_dir ./finetuned-ct2
# Then set: WHISPER_FINETUNED_REPO=./finetuned-ct2
WHISPER_FINETUNED_REPO=

# HuggingFace access token for private model repos
# Get your token at: https://huggingface.co/settings/tokens
# Required when WHISPER_FINETUNED_REPO points to a private HuggingFace repo
HF_TOKEN=

# Device: cpu/cuda/auto
WHISPER_DEVICE=cuda

# Compute type: int8/float16/int8_float16/auto
# float16 = best quality, highest VRAM usage
# int8_float16 = good quality, lower VRAM usage
# int8 = fastest, lowest quality
WHISPER_COMPUTE_TYPE=float16

# Beam search size (higher = better quality, slower)
WHISPER_BEAM_SIZE=5

# Voice Activity Detection filter (removes silence)
WHISPER_VAD_FILTER=true

# Custom initial prompt for business vocabulary
# Leave empty to use built-in Tunisian/French business terms
# WHISPER_INITIAL_PROMPT=

# Google Gemini API Key for AI-powered meeting analysis
# Get your key at: https://aistudio.google.com/apikey
# When set, transcriptions are analyzed by Gemini (understands Tunisian natively)
# When empty, falls back to keyword-based analysis (French only)
GEMINI_API_KEY=

# Gemini model to use for analysis
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
# If you hit quota limits on one model, try switching
GEMINI_MODEL=gemini-2.5-flash