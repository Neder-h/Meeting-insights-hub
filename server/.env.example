MONGODB_URI=mongodb://localhost:27017/salesai
JWT_SECRET=change-me-before-production
PORT=3001

# Leave empty to disable Gemini-backed analysis/email generation locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to true only if Redis is running locally.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

WHISPER_API_URL=http://127.0.0.1:9000
TRANSLATE_API_URL=http://127.0.0.1:9100
UPLOAD_CHUNK_SIZE_BYTES=5242880
